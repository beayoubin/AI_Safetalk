PORT=4000
TZ=Asia/Seoul

DB_CLIENT=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_DATABASE=tbm_ai
DB_CONNECTION_LIMIT=10
WEATHER_PROVIDER=kma-short-term
WEATHER_LOCATION_NAME=여수산단
WEATHER_SITE_ID=
WEATHER_SYNC_ENABLED=true
WEATHER_SYNC_INTERVAL_MS=600000
WEATHER_SYNC_USE_HOURLY_CADENCE=true
WEATHER_SYNC_MINUTE_OFFSET=0
WEATHER_BACKFILL_HOURS=12
KMA_SERVICE_KEY=your_kma_service_key
KMA_NX=73
KMA_NY=67
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tbm_knowledge

# PDF 한글 출력용 폰트 경로 (선택)
# PDF_FONT_PATH=/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc

